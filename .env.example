# OmniReach: environment reference.
# NOTE: lines starting with "# NAME=" are optional overrides. Leave them commented: an EMPTY value overrides the built-in default.
# Local: copy to .env.local (Next.js + scripts read it) AND to .env (the Prisma CLI reads only .env). Keep the two in sync.
# Production: set the same names in Vercel -> Project Settings -> Environment Variables. Run `pnpm doctor` to validate.
# Supabase is used ONLY as a Postgres host. There are no Supabase API keys in this app.

# ───────────────────────── REQUIRED ─────────────────────────
# Local / long-lived server: Supabase "Session pooler" string (Connect -> Session pooler, port 5432). IPv4 safe.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30
# Vercel (serverless): DATABASE_URL must be the "Transaction pooler" (port 6543) with pgbouncer + one connection per function:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1
# and keep the Session pooler string as DIRECT_URL (used by `prisma db push`). Locally both may be the same Session pooler URL.
# URL-encode special characters in the password.
DATABASE_URL=
DIRECT_URL=

# Public https URL of this deployment (no trailing slash). Used in emails, webhooks, unsubscribe links, CSRF origin checks.
# Local: http://localhost:3000   Production: https://app.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32 random bytes as 64 hex chars; encrypts per-org tokens. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes stored tokens unreadable: rotate by setting the old value in ENCRYPTION_KEY_PREVIOUS.
ENCRYPTION_KEY=
# ENCRYPTION_KEY_PREVIOUS=

# ───────────────────────── EMAIL (needed in production for sign-up verification + password reset) ─────────────────────────
# Without RESEND_API_KEY in DEVELOPMENT, accounts auto-verify and links are printed in the server log.
# Sandbox testing: EMAIL_FROM=OmniReach <onboarding@resend.dev> only delivers to your own Resend login email.
# Real sending: verify a domain in Resend (add its SPF/DKIM DNS records), then use an address on it.
RESEND_API_KEY=
EMAIL_FROM=OmniReach <onboarding@resend.dev>

# ───────────────────────── BACKGROUND JOBS (Inngest). Production only; locally use `pnpm inngest:dev` ─────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ───────────────────────── WHATSAPP (Meta Cloud API). Per-org token + phone id are saved in the app (/channels) ─────────────────────────
# Webhook URL: <APP_URL>/api/webhooks/whatsapp   Subscribe to: messages
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=
# WA_GRAPH_VERSION=
WA_TEMPLATE_LANGUAGE=en
# WA_HTTP_TIMEOUT_MS=

# ───────────────────────── INSTAGRAM / MESSENGER (same Meta app) ─────────────────────────
# Webhook URL: <APP_URL>/api/webhooks/meta
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_VERSION=
# Telegram needs NO env var: paste the @BotFather token at /channels.

# ───────────────────────── AI ─────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ───────────────────────── VOICE (Vapi + ElevenLabs + Twilio inside Vapi) ─────────────────────────
# Webhook URL: <APP_URL>/api/webhooks/vapi   (secret sent in the header named by VAPI_WEBHOOK_HEADER, default x-vapi-secret)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
# VAPI_WEBHOOK_HEADER=
VAPI_GEMINI_MODEL=gemini-2.0-flash
# VAPI_HTTP_TIMEOUT_MS=
ELEVENLABS_API_KEY=
# ELEVENLABS_DEFAULT_VOICE_ID=
# Spoken at the start of every AI call. {org} is replaced. Set ENABLED=false only after legal advice.
AI_CALL_DISCLOSURE_ENABLED=true
# AI_CALL_DISCLOSURE_TEXT=

# ───────────────────────── BILLING (Razorpay). Webhook URL: <APP_URL>/api/webhooks/razorpay ─────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
USD_INR_RATE=84

# ───────────────────────── COMPLIANCE / TUNING (all optional) ─────────────────────────
# STOP keyword scope: "all" (default, opt out of every channel) or "channel".
STOP_SCOPE=all
# OPT_OUT_KEYWORDS=
# STOP_CONFIRMATION_TEXT=
# Set to a header your proxy sets authoritatively if you deploy somewhere other than Vercel (e.g. cf-connecting-ip).
# CLIENT_IP_HEADER=
# SLACK_WEBHOOK_URL=
# EMAIL_HTTP_TIMEOUT_MS=
# RESEND_IDEMPOTENT_RETRY=
# CAMPAIGN_LEASE_TTL_MS=
# RECONCILE_STUCK_MINUTES=
# WEBHOOK_EVENT_RETENTION_DAYS=
