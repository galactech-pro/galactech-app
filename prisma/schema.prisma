generator client {
  provider = "prisma-client-js"
}

// NOTE: Prisma connects as a DB role and bypasses Supabase RLS, so org_id scoping is enforced in code
// (see lib/api.ts withAuth). Enable RLS with no policies on every table as defence-in-depth against the anon key.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────── Enums ─────────────
enum plan {
  free
  starter
  growth
  pro
}

enum user_role {
  owner
  admin
  member
  viewer
}

enum contact_status {
  new
  contacted
  qualified
  demo
  won
  lost
}

enum channel {
  whatsapp
  email
  voice
  sms
  telegram
  instagram
  messenger
  webchat
  api
}

enum conversation_status {
  open
  pending
  resolved
  snoozed
}

enum consent_status {
  granted
  revoked
}

enum ai_draft_status {
  pending
  approved
  rejected
  sent
  expired
}

enum campaign_type {
  broadcast
  sequence
}

enum campaign_status {
  draft
  scheduled
  sending
  sent
  paused
}

enum message_direction {
  inbound
  outbound
}

enum message_status {
  queued
  sent
  delivered
  read
  failed
}

enum call_status {
  initiated
  ringing
  in_progress
  completed
  failed
  no_answer
}

enum call_outcome {
  interested
  callback
  not_interested
  no_answer
  voicemail
}

enum automation_trigger {
  new_contact
  form_submission
  tag_added
  score_changed
  campaign_reply
  time_based
  webhook
  api
}

enum automation_run_status {
  running
  completed
  failed
  stopped
}

enum deal_stage {
  lead
  qualified
  demo
  proposal
  won
  lost
}

enum subscription_status {
  active
  past_due
  cancelled
  trialing
}

enum invoice_status {
  paid
  failed
}

enum integration_provider {
  shopify
  zoho
  google_sheets
  calendly
  typeform
  woocommerce
}

// ───────────── Tables ─────────────
model organisations {
  id                    String    @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String    @unique
  logo_url              String?
  logo                  org_logos?
  plan                  plan      @default(free)
  trial_ends_at         DateTime?
  // wa_access_token and resend_api_key are stored AES-256-GCM encrypted (see apps/web/lib/crypto.ts)
  wa_phone_number_id    String?   @unique // one WABA number belongs to exactly one org
  wa_access_token       String?
  wa_business_account_id String?
  resend_api_key        String?
  elevenlabs_voice_id   String?
  timezone              String    @default("Asia/Kolkata")
  language              String    @default("en")
  white_label           Boolean   @default(false)
  custom_domain         String?
  parent_org_id         String?   @db.Uuid // agency → sub-client (WF-010)
  onboarding_step       Int       @default(0)
  call_window_start     Int       @default(9)  // local hour; AI calls only inside [start,end) in org timezone
  call_window_end       Int       @default(21)
  auto_outreach_enabled Boolean   @default(false) // automations may message contacts only when true AND consent recorded
  ai_approval_required  Boolean   @default(true)  // AI-written messages go to ai_drafts for human approval
  onboarding_done       Boolean   @default(false)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  parent         organisations?  @relation("OrgTree", fields: [parent_org_id], references: [id])
  children       organisations[] @relation("OrgTree")
  users          users[]
  contacts       contacts[]
  campaigns      campaigns[]
  messages       messages[]
  ai_calls       ai_calls[]
  automations    automations[]
  deals          deals[]
  usage          usage[]
  subscriptions  subscriptions[]
  invoices       invoices[]
  api_keys       api_keys[]
  audit_log      audit_log[]
  integrations   integrations[]
  tasks          tasks[]
  notes          notes[]
  invites        invites[]
  score_history  score_history[]
  inboxes        inboxes[]
  conversations  conversations[]
  consents       consents[]
  ai_drafts      ai_drafts[]
  ai_runs        ai_runs[]
}

model users {
  id           String     @id @default(uuid()) @db.Uuid
  org_id       String     @db.Uuid
  email        String     @unique // always stored lower-case; one account per email
  password_hash String?   // scrypt, see lib/password.ts
  email_verified_at DateTime?
  sessions     user_sessions[]
  auth_tokens  auth_tokens[]
  full_name    String?
  avatar_url   String?
  role         user_role  @default(member)
  is_active    Boolean    @default(true)
  last_seen_at DateTime?
  created_at   DateTime   @default(now())

  org organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  assigned_contacts contacts[]  @relation("ContactAssignee")
  assigned_deals    deals[]     @relation("DealAssignee")
  tasks_assigned    tasks[]     @relation("TaskAssignee")
  tasks_created     tasks[]     @relation("TaskCreator")
  notes             notes[]
  campaigns_created campaigns[]
  automations_created automations[]
  api_keys_created  api_keys[]
  audit_entries     audit_log[]

  @@index([org_id])
  @@index([email])
}

model contacts {
  id             String         @id @default(uuid()) @db.Uuid
  org_id         String         @db.Uuid
  full_name      String
  phone          String
  email          String?
  company        String?
  job_title      String?
  source         String?
  tags           String[]       @default([])
  lead_score     Int?           // 1-10, null = unscored
  score_reason   String?
  status         contact_status @default(new)
  assigned_to    String?        @db.Uuid
  custom_fields  Json           @default("{}")
  wa_opt_out     Boolean        @default(false)
  email_opt_out  Boolean        @default(false)
  dnc            Boolean        @default(false)
  is_active      Boolean        @default(true) // soft delete
  last_contacted_at DateTime?
  version        Int            @default(1) // optimistic concurrency for CRM edits
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  org      organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  assignee users?        @relation("ContactAssignee", fields: [assigned_to], references: [id])
  messages messages[]
  ai_calls ai_calls[]
  deals    deals[]
  tasks    tasks[]
  notes    notes[]
  automation_runs automation_runs[]
  score_history   score_history[]
  contact_inboxes contact_inboxes[]
  conversations   conversations[]
  consents        consents[]
  ai_drafts       ai_drafts[]

  @@unique([org_id, phone])
  @@index([org_id, lead_score])
  @@index([org_id, status])
}

model score_history {
  id         String   @id @default(uuid()) @db.Uuid
  org_id     String   @db.Uuid
  contact_id String   @db.Uuid
  score      Int
  reason     String?
  created_at DateTime @default(now())

  org     organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  contact contacts      @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@index([contact_id, created_at])
}

model notes {
  id         String   @id @default(uuid()) @db.Uuid
  org_id     String   @db.Uuid
  contact_id String   @db.Uuid
  user_id    String   @db.Uuid
  body       String
  created_at DateTime @default(now())

  org     organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  contact contacts      @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  user    users         @relation(fields: [user_id], references: [id])

  @@index([contact_id])
}

model tasks {
  id          String    @id @default(uuid()) @db.Uuid
  org_id      String    @db.Uuid
  contact_id  String?   @db.Uuid
  title       String
  due_at      DateTime?
  done        Boolean   @default(false)
  assigned_to String?   @db.Uuid
  created_by  String?   @db.Uuid
  created_at  DateTime  @default(now())

  org      organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  contact  contacts?     @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  assignee users?        @relation("TaskAssignee", fields: [assigned_to], references: [id])
  creator  users?        @relation("TaskCreator", fields: [created_by], references: [id])

  @@index([org_id, done])
}

model campaigns {
  id              String          @id @default(uuid()) @db.Uuid
  org_id          String          @db.Uuid
  name            String
  channel         channel
  type            campaign_type   @default(broadcast)
  status          campaign_status @default(draft)
  audience_filter Json            @default("{}")
  template_id     String?
  content         Json            @default("{}") // { body, subject?, buttons?, media_url? }
  scheduled_at    DateTime?
  sent_at         DateTime?
  stats           Json            @default("{}") // { total, sent, delivered, opened, clicked, replied, converted }
  created_by      String?         @db.Uuid
  created_at      DateTime        @default(now())

  org      organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  creator  users?        @relation(fields: [created_by], references: [id])
  messages messages[]
  deals    deals[]

  @@index([org_id, status])
}

model messages {
  id          String            @id @default(uuid()) @db.Uuid
  org_id      String            @db.Uuid
  contact_id  String            @db.Uuid
  campaign_id String?           @db.Uuid
  channel     channel
  direction   message_direction
  content     String
  status      message_status    @default(queued)
  wa_message_id String?
  inbox_id    String?           @db.Uuid
  conversation_id String?       @db.Uuid
  external_id String?           // provider message id; with inbox_id gives idempotent inbound
  idempotency_key String?       @unique // outbox key, set BEFORE calling the provider
  error       String?
  opened_at   DateTime?
  clicked_at  DateTime?
  replied_at  DateTime?
  sent_at     DateTime?
  created_at  DateTime          @default(now())

  org      organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  contact  contacts      @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  campaign campaigns?    @relation(fields: [campaign_id], references: [id])
  inbox    inboxes?      @relation(fields: [inbox_id], references: [id])
  conversation conversations? @relation(fields: [conversation_id], references: [id])

  @@unique([inbox_id, external_id])
  @@index([conversation_id, created_at])
  @@index([org_id, contact_id, created_at])
  @@index([campaign_id])
  @@index([wa_message_id])
}

model ai_calls {
  id               String        @id @default(uuid()) @db.Uuid
  org_id           String        @db.Uuid
  contact_id       String        @db.Uuid
  vapi_call_id     String?       @unique
  from_number      String?
  to_number        String
  status           call_status   @default(initiated)
  duration_seconds Int?
  transcript       String?
  summary          String?
  outcome          call_outcome?
  recording_url    String?
  cost_inr         Decimal?      @db.Decimal(10, 2)
  attempt          Int           @default(1)
  scheduled_at     DateTime?
  created_at       DateTime      @default(now())

  org     organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  contact contacts      @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@index([org_id, created_at])
}

model automations {
  id             String             @id @default(uuid()) @db.Uuid
  org_id         String             @db.Uuid
  name           String
  description    String?
  trigger_type   automation_trigger
  trigger_config Json               @default("{}")
  steps          Json               @default("{\"nodes\":[],\"edges\":[]}") // React Flow graph
  is_active      Boolean            @default(false)
  run_count      Int                @default(0)
  last_run_at    DateTime?
  created_by     String?            @db.Uuid
  created_at     DateTime           @default(now())

  org     organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  creator users?        @relation(fields: [created_by], references: [id])
  runs    automation_runs[]

  @@index([org_id, is_active])
}

model automation_runs {
  id            String                @id @default(uuid()) @db.Uuid
  automation_id String                @db.Uuid
  contact_id    String                @db.Uuid
  status        automation_run_status @default(running)
  current_step  String?
  resume_at     DateTime?
  started_at    DateTime              @default(now())
  completed_at  DateTime?
  error_message String?

  automation automations @relation(fields: [automation_id], references: [id], onDelete: Cascade)
  contact    contacts    @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@index([automation_id, status])
  @@index([status, resume_at])
}

model deals {
  id                 String     @id @default(uuid()) @db.Uuid
  org_id             String     @db.Uuid
  contact_id         String     @db.Uuid
  title              String
  value_inr          Decimal    @default(0) @db.Decimal(12, 2)
  stage              deal_stage @default(lead)
  probability        Int        @default(10)
  assigned_to        String?    @db.Uuid
  source_campaign_id String?    @db.Uuid
  notes              String?
  closed_at          DateTime?
  created_at         DateTime   @default(now())

  org      organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  contact  contacts      @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  assignee users?        @relation("DealAssignee", fields: [assigned_to], references: [id])
  campaign campaigns?    @relation(fields: [source_campaign_id], references: [id])

  @@index([org_id, stage])
}

model plan_limits {
  plan                plan    @id
  max_contacts        Int
  max_wa_messages_mo  Int
  max_emails_mo       Int
  max_ai_calls_mo     Int
  max_team_seats      Int
  max_automations     Int
  features            Json    @default("{}")
  price_monthly_inr   Int
  price_annual_inr    Int
  razorpay_plan_id    String?
}

model usage {
  id                    String   @id @default(uuid()) @db.Uuid
  org_id                String   @db.Uuid
  month                 DateTime @db.Date // first day of month
  wa_sent               Int      @default(0)
  emails_sent           Int      @default(0)
  ai_calls_made         Int      @default(0)
  contacts_created      Int      @default(0)
  automations_triggered Int      @default(0)
  reset_at              DateTime?

  org organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([org_id, month])
}

model subscriptions {
  id                   String              @id @default(uuid()) @db.Uuid
  org_id               String              @db.Uuid
  plan                 plan
  status               subscription_status @default(trialing)
  razorpay_sub_id      String?             @unique
  razorpay_customer_id String?
  current_period_start DateTime?
  current_period_end   DateTime?
  cancelled_at         DateTime?

  org      organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  invoices invoices[]

  @@index([org_id])
}

model invoices {
  id                  String         @id @default(uuid()) @db.Uuid
  org_id              String         @db.Uuid
  subscription_id     String?        @db.Uuid
  amount_inr          Decimal        @db.Decimal(12, 2)
  currency            String         @default("INR")
  status              invoice_status
  razorpay_invoice_id String?        @unique
  pdf_url             String?
  issued_at           DateTime       @default(now())
  paid_at             DateTime?

  org          organisations  @relation(fields: [org_id], references: [id], onDelete: Cascade)
  subscription subscriptions? @relation(fields: [subscription_id], references: [id])

  @@index([org_id])
}

model api_keys {
  id           String    @id @default(uuid()) @db.Uuid
  org_id       String    @db.Uuid
  name         String
  key_hash     String    @unique // sha256 of the key; plaintext shown once
  key_prefix   String
  last_used_at DateTime?
  expires_at   DateTime?
  created_by   String?   @db.Uuid
  created_at   DateTime  @default(now())

  org     organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  creator users?        @relation(fields: [created_by], references: [id])

  @@index([org_id])
}

model audit_log {
  id          String   @id @default(uuid()) @db.Uuid
  org_id      String   @db.Uuid
  user_id     String?  @db.Uuid
  action      String
  entity_type String
  entity_id   String?
  before      Json?
  after       Json?
  ip_address  String?
  created_at  DateTime @default(now())

  org  organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user users?        @relation(fields: [user_id], references: [id])

  @@index([org_id, created_at])
}

model integrations {
  id        String               @id @default(uuid()) @db.Uuid
  org_id    String               @db.Uuid
  provider  integration_provider
  config    String               // AES-256-GCM encrypted JSON
  is_active Boolean              @default(true)
  last_sync_at DateTime?

  org organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([org_id, provider])
}

model invites {
  id         String    @id @default(uuid()) @db.Uuid
  org_id     String    @db.Uuid
  email      String
  role       user_role @default(member)
  token      String    @unique
  expires_at DateTime
  accepted_at DateTime?
  created_at DateTime  @default(now())

  org organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@index([org_id])
}

// ───────────── Omnichannel (modelled on Chatwoot: account → inbox → contact_inbox → conversation → message) ─────────────
model inboxes {
  id            String   @id @default(uuid()) @db.Uuid
  org_id        String   @db.Uuid
  channel       channel
  provider      String   @default("default") // whatsapp_cloud | resend | telegram_bot | twilio | meta_graph ...
  name          String
  identifier    String   // WA phone_number_id | sending address | bot id | page id (globally unique per channel)
  config        String   // AES-256-GCM encrypted JSON (tokens, secrets)
  webhook_token String   @unique // opaque id for per-inbox webhook URLs
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  org             organisations     @relation(fields: [org_id], references: [id], onDelete: Cascade)
  contact_inboxes contact_inboxes[]
  conversations   conversations[]
  messages        messages[]

  @@unique([channel, identifier])
  @@index([org_id])
}

model contact_inboxes {
  id         String   @id @default(uuid()) @db.Uuid
  contact_id String   @db.Uuid
  inbox_id   String   @db.Uuid
  source_id  String   // the contact's address on that channel (phone, chat_id, IGSID, email)
  created_at DateTime @default(now())

  contact contacts @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  inbox   inboxes  @relation(fields: [inbox_id], references: [id], onDelete: Cascade)

  @@unique([inbox_id, source_id])
  @@unique([contact_id, inbox_id])
}

model conversations {
  id              String              @id @default(uuid()) @db.Uuid
  org_id          String              @db.Uuid
  contact_id      String              @db.Uuid
  inbox_id        String              @db.Uuid
  status          conversation_status @default(open)
  assignee_id     String?             @db.Uuid
  unread_count    Int                 @default(0)
  last_inbound_at DateTime?           // drives the WhatsApp 24h session window
  last_message_at DateTime            @default(now())
  created_at      DateTime            @default(now())

  org      organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  contact  contacts      @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  inbox    inboxes       @relation(fields: [inbox_id], references: [id], onDelete: Cascade)
  messages messages[]

  @@index([org_id, status, last_message_at])
  @@index([contact_id, inbox_id])
}

// Inbound webhook dedup: INSERT … ON CONFLICT DO NOTHING; process only if a row was inserted.
model webhook_events {
  id           String    @id @default(uuid()) @db.Uuid
  provider     String
  event_id     String
  org_id       String?   @db.Uuid
  received_at  DateTime  @default(now())
  processed_at DateTime?

  @@unique([provider, event_id])
  @@index([received_at])
}

// Append-only consent ledger. Latest row per (contact, channel) wins.
model consents {
  id         String         @id @default(uuid()) @db.Uuid
  org_id     String         @db.Uuid
  contact_id String         @db.Uuid
  channel    channel
  status     consent_status
  source     String         // import_attested | form | whatsapp_optin | inbound_message | stop_keyword | manual | api
  evidence   Json?
  created_at DateTime       @default(now())

  org     organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  contact contacts      @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@index([contact_id, channel, created_at])
}

// AI-written outbound content awaiting human approval (when organisations.ai_approval_required).
model ai_drafts {
  id         String          @id @default(uuid()) @db.Uuid
  org_id     String          @db.Uuid
  contact_id String          @db.Uuid
  channel    channel
  subject    String?
  body       String
  context    Json            @default("{}") // grounding facts used + origin (automation|inbox|campaign|voice_script)
  status     ai_draft_status @default(pending)
  decided_by String?         @db.Uuid
  decided_at DateTime?
  created_at DateTime        @default(now())

  org     organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  contact contacts      @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@index([org_id, status])
}

// Every LLM call is logged for audit/eval. Input stored as a hash only (PII minimisation).
model ai_runs {
  id             String   @id @default(uuid()) @db.Uuid
  org_id         String   @db.Uuid
  kind           String
  model          String
  prompt_version String
  input_hash     String
  output         Json?
  valid          Boolean  @default(false)
  error          String?
  latency_ms     Int?
  created_at     DateTime @default(now())

  org organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@index([org_id, kind, created_at])
}

// Fixed-window rate limiter (atomic upsert-increment) for auth, public and API-key endpoints.
model rate_limits {
  key          String
  window_start DateTime
  count        Int      @default(0)

  @@id([key, window_start])
}

// ───────────── Own auth (no Supabase Auth) ─────────────
/// Server-side sessions. Only sha256(token) is stored; the raw token lives in an httpOnly cookie.
model user_sessions {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  ip         String?
  user_agent String?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

/// Single-use tokens for email verification and password reset (sha256 stored, never the raw token).
model auth_tokens {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  type       String // verify_email | reset_password
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, type])
}

/// Organisation logo bytes (served by /api/public/logo/[orgId]); replaces Supabase Storage.
model org_logos {
  org_id       String   @id @db.Uuid
  content_type String
  data         Bytes
  updated_at   DateTime @default(now()) @updatedAt

  org organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
}
