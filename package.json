{
  "name": "galactech",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:tenant": "tsx --env-file-if-exists=.env.local scripts/tenant-isolation-check.ts",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file-if-exists=.env.local prisma/seed.ts",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "check:idempotency": "tsx --env-file-if-exists=.env.local scripts/idempotency-check.ts",
    "check:ai": "tsx --env-file-if-exists=.env.local scripts/ai-guard-check.ts",
    "db:rls": "prisma db execute --file prisma/rls.sql --schema prisma/schema.prisma",
    "doctor": "tsx --env-file-if-exists=.env.local scripts/doctor.ts",
    "smoke:auth": "tsx --env-file-if-exists=.env.local scripts/auth-smoke.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "@google/generative-ai": "0.21.0",
    "@hookform/resolvers": "3.9.1",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-checkbox": "1.1.2",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-progress": "1.1.0",
    "@radix-ui/react-select": "2.1.2",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.1",
    "@radix-ui/react-tabs": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.3",
    "@react-email/components": "0.0.28",
    "@tanstack/react-query": "5.59.20",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "inngest": "3.54.0",
    "lucide-react": "0.460.0",
    "next": "15.5.29",
    "papaparse": "5.4.1",
    "razorpay": "2.9.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.53.2",
    "reactflow": "11.11.4",
    "recharts": "2.13.3",
    "resend": "4.0.1",
    "sonner": "1.7.0",
    "tailwind-merge": "2.5.4",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/papaparse": "5.3.15",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
